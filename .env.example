# Copy to .env and fill in. Never commit .env.

# "production" on the live server; leave as "development" locally
NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/new_electricity"

# Any long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Production only: the frontend's address(es), comma-separated
CORS_ORIGINS=https://your-frontend.example.com
# Where links in emails point. Defaults to http://localhost:5173 in development.
FRONTEND_URL=https://your-frontend.example.com

# Email (password reset). Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# Without these in development, emails are printed to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
# Optional: defaults to "APP_NAME" <SMTP_USER>
# EMAIL_FROM="141 Electricity" <you@gmail.com>

# Email branding (all optional)
APP_NAME=141 Electricity
BRAND_COLOR=#1D4ED8
# Public https link to a PNG logo, about 36px tall when shown
LOGO_URL=
# Defaults to SMTP_USER
SUPPORT_EMAIL=

# Receipt scanning (optional: without it, scanning returns 503 and users type details in)
ANTHROPIC_API_KEY=

# Receipt image storage (required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
